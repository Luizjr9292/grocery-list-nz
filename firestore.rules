rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isOwnerRead(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'order', 'collapsed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'order', 'collapsed', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.collapsed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidItem(data, userId) {
      return data.keys().hasAll(['ownerId', 'categoryId', 'name', 'selected', 'quantity', 'bought', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'categoryId', 'name', 'selected', 'quantity', 'bought', 'order', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.categoryId is string && isValidId(data.categoryId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.selected is bool
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 999
        && data.bought is bool
        && data.order is int && data.order >= 0 && data.order <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private user profile (PII isolated strictly to owner)
    match /users/{userId}/private/{docId} {
      allow get: if isOwnerRead(userId) && isValidId(userId) && isValidId(docId) && docId == 'profile';
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && docId == 'profile'
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if false;
    }

    // User grocery categories
    match /users/{userId}/categories/{categoryId} {
      allow get: if isOwnerRead(userId) && isValidId(userId) && isValidId(categoryId);
      allow list: if isOwnerRead(userId) && isValidId(userId) && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(categoryId)
        && isValidCategory(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(categoryId)
        && isValidCategory(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['collapsed', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order', 'collapsed', 'updatedAt'])
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(categoryId);
    }

    // User grocery items
    match /users/{userId}/items/{itemId} {
      allow get: if isOwnerRead(userId) && isValidId(userId) && isValidId(itemId);
      allow list: if isOwnerRead(userId) && isValidId(userId) && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(itemId)
        && isValidItem(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(userId)/categories/$(incoming().categoryId));

      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidId(itemId)
        && isValidItem(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['selected', 'bought', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['bought', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['selected', 'quantity', 'bought', 'updatedAt'])
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(itemId);
    }
  }
}
